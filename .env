# Copy to .env and fill in. Never commit .env.
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Geoapify key (free, no credit card): https://myprojects.geoapify.com
# Restrict it to your domains in the Geoapify project settings.
GEOAPIFY_API_KEY=flask = 5a59cc23dec544db9866c70c76332c79

# Leave empty for SQLite in development. For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/express_mtaani
DATABASE_URL=

# Optional tuning (defaults shown)
# NEARBY_RADIUS_KM=6          riders see new orders from shops within this distance of them
# RIDER_FRESH_SECONDS=120     a rider counts as online if their location is newer than this
# DELIVERY_BASE_FEE=100       KES
# DELIVERY_PER_KM=30          KES per started km (shop to customer, straight line)
